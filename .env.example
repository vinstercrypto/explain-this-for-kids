# Copy this file to .env and add your actual values

# Claude API Key - Get from: https://console.anthropic.com/
CLAUDE_API_KEY=your_api_key_here

# Flask Secret Key - Generate a random string for production
# You can use: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_secret_key_here

# SMTP Email Configuration - For "Email me a copy" feature
# For Gmail: Use app-specific password (https://myaccount.google.com/apppasswords)
# For other providers: Check their SMTP settings documentation

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your.email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM_EMAIL=your.email@gmail.com

# NOTE: The email feature is optional. If not configured,
# the app will still work but the "Email me a copy" feature will be disabled.

# Optional: Donation URL (e.g., PayPal, Ko-fi, Buy Me a Coffee, etc.)
# If set, a "Donate" button will appear on the main page and share pages
# If unset or empty, the donate button will be hidden
DONATE_URL=
